{
  "name": "automattic/newspack-content-diff-migrator",
  "autoload": {
    "classmap": [
      "src/",
      "tests/"
    ]
  },
  "repositories": [
    {
      "url": "https://github.com/Automattic/newspack-content-converter.git",
      "type": "vcs"
    },
    {
        "type": "vcs",
        "url": "https://github.com/Automattic/newspack-migration-tools.git"
    }
  ],
  "require": {
    "automattic/newspack-content-converter": "dev-master",
    "automattic/newspack-migration-tools": "dev-trunk",
    "monolog/monolog": "^3.7",
    "bramus/monolog-colored-line-formatter": "^3.1",
    "simplehtmldom/simplehtmldom": "2.0-RC2"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "composer/installers": "^2.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
    "yoast/phpunit-polyfills": "^1.0",
    "phpunit/phpunit": "9.*",
    "sirbrillig/phpcs-changed": "^2.11"
  },
  "config": {
    "vendor-dir": "vendor",
    "platform-check": false,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "archive": {
    "exclude": [
      "!vendor/*",
      "create_release.sh",
      "release/*",
      "bin/*",
      "tests/*",
      "phpunit*",
      ".phpunit*",
      "phpcs*",
      ".phpcs*",
      ".travis.yml",
      ".git*",
      ".git/*",
      ".github/*",
      ".distignore",
      ".DS_Store",
      ".env*",
      ".idea",
      "*.log*",
      "release",
      "pull_request_template.md"
    ]
  },
  "scripts": {
    "phpcs": "./vendor/bin/phpcs",
    "phpcbf": "./vendor/bin/phpcbf",
    "phpunit": "./vendor/bin/phpunit",
    "code-coverage-clover": "export XDEBUG_MODE=coverage && ./vendor/bin/phpunit --coverage-clover build/coverage_clover/clover.xml",
    "code-coverage-html": "export XDEBUG_MODE=coverage && ./vendor/bin/phpunit --coverage-html build/coverage_html",
    "build-release": [
        "rm -rf vendor 2>/dev/null || true",
        "rm -rf release",
        "composer install --no-dev --optimize-autoloader",
        "composer archive --format=zip --dir=release --file=newspack-content-diff-migrator"
    ],
    "gh-release": [
        "@build-release",
        "./.github/scripts/gh-release.sh"
    ],
    "update-with-nmt-symlinked": [
      "rm -rf  vendor/automattic/newspack-migration-tools",
      "composer install",
      "rm -rf vendor/automattic/newspack-migration-tools",
      "ln -s ../../dev/newspack-migration-tools vendor/automattic/newspack-migration-tools"
    ]
  }
}
